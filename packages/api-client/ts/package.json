{
  "name": "@voice-intercom/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "REST API のクライアント(TypeScript)。型は ../openapi.json から生成する",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gen": "pnpm dlx --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 openapi-typescript ../openapi.json -o src/gen/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
