# .env にコピーして使う(.env は git 管理外)。mise が自動で読み込む。

# ホストの LAN の IP。実機・エミュレーター・ブラウザ・コンテナが、同じアドレスで OIDC と LiveKit に届くようにする
DEV_HOST=192.168.1.10

# 模擬 OIDC サーバー(.devcontainer/compose.yaml の oidc)
# トークンの iss はリクエストの Host で決まるので、クライアントは必ず DEV_HOST で接続する
OIDC_ISSUER=http://192.168.1.10:8090/default
# コンテナ内から鍵を取るときは compose のサービス名で届く
OIDC_JWKS_URL=http://oidc:8090/default/jwks
# API が受け付ける client_id(カンマ区切り)。模擬 OIDC では、ログイン画面の claims か
# client credentials の client_id で決まる。Agent のトークンは scope(voice-intercom/agent)で見分ける
OIDC_CLIENT_IDS=mobile,admin,agent

# LiveKit。ローカルはホストで mise run livekit。Cloud を使うときは Cloud の値に差し替える
LIVEKIT_URL=ws://host.docker.internal:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# API がトークンと一緒にアプリへ返す接続先。実機からも届くよう DEV_HOST で書く
LIVEKIT_CLIENT_URL=ws://192.168.1.10:7880

OPENAI_API_KEY=

# AWS(aws sso login で使うプロファイル)
AWS_PROFILE=
TF_STATE_BUCKET=
