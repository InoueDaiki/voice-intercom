{
  "openapi": "3.1.0",
  "info": {
    "title": "voice-intercom API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/rooms/{room_id}": {
      "get": {
        "tags": [
          "rooms"
        ],
        "summary": "ルームを取る(管理者かメンバー)",
        "operationId": "getRoom",
        "parameters": [
          {
            "description": "ルームの ID",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "title": "Room Id",
              "description": "ルームの ID"
            },
            "name": "room_id",
            "in": "path"
          }
        ],
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Room"
                }
              }
            }
          },
          "401": {
            "description": "トークンがない、または不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "このトークンでは使えない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "ルームがない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "rooms"
        ],
        "summary": "ルームを消す(管理者)",
        "operationId": "deleteRoom",
        "parameters": [
          {
            "description": "ルームの ID",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "title": "Room Id",
              "description": "ルームの ID"
            },
            "name": "room_id",
            "in": "path"
          }
        ],
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "204": {
            "description": "消した",
            "content": {}
          },
          "401": {
            "description": "トークンがない、または不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "このトークンでは使えない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "ルームがない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "patch": {
        "tags": [
          "rooms"
        ],
        "summary": "ルームの名前とメンバーを変える(管理者)",
        "operationId": "updateRoom",
        "parameters": [
          {
            "description": "ルームの ID",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "title": "Room Id",
              "description": "ルームの ID"
            },
            "name": "room_id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRoomRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Room"
                }
              }
            }
          },
          "401": {
            "description": "トークンがない、または不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "このトークンでは使えない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "ルームがない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "死活監視",
        "operationId": "getHealth",
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rooms": {
      "get": {
        "tags": [
          "rooms"
        ],
        "summary": "ルームの一覧。管理者にはすべて、それ以外の人には自分がメンバーのルームを返す",
        "operationId": "listRooms",
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomList"
                }
              }
            }
          },
          "401": {
            "description": "トークンがない、または不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "このトークンでは使えない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "rooms"
        ],
        "summary": "ルームを作る(管理者)",
        "operationId": "createRoom",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoomRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "201": {
            "description": "作った",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Room"
                }
              }
            }
          },
          "401": {
            "description": "トークンがない、または不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "このトークンでは使えない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "同じ room_id のルームが既にある",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/users/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "自分のプロフィールを取る",
        "operationId": "getMyProfile",
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "トークンがない、または不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "このトークンでは使えない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "プロフィールをまだ登録していない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "users"
        ],
        "summary": "自分のプロフィールを登録・更新する",
        "operationId": "putMyProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "トークンがない、または不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "このトークンでは使えない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/users": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "ユーザーの一覧(管理者)。プロフィールを登録した人だけを返す",
        "operationId": "listUsers",
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserList"
                }
              }
            }
          },
          "401": {
            "description": "トークンがない、または不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "このトークンでは使えない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/livekit/token": {
      "post": {
        "tags": [
          "livekit"
        ],
        "summary": "LiveKit の参加用トークンを発行する(管理者かルームのメンバー)",
        "operationId": "createLiveKitToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LiveKitTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveKitTokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "トークンがない、または不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "このトークンでは使えない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "ルームがない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "プロフィール(表示名と言語)をまだ登録していない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateRoomRequest": {
        "properties": {
          "room_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Room Id",
            "description": "ルームの ID"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "description": "ルームの表示名"
          },
          "member_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Member Ids",
            "description": "メンバーの user_id(Cognito の sub)",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "room_id",
          "name"
        ],
        "title": "CreateRoomRequest"
      },
      "ErrorResponse": {
        "properties": {
          "statusCode": {
            "type": "integer",
            "title": "Statuscode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "statusCode",
          "message"
        ],
        "title": "ErrorResponse",
        "description": "エラーの本文(Powertools の ServiceError が返す形)。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "LiveKitTokenRequest": {
        "properties": {
          "room_name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Room Name",
            "description": "入るルームの名前"
          }
        },
        "type": "object",
        "required": [
          "room_name"
        ],
        "title": "LiveKitTokenRequest"
      },
      "LiveKitTokenResponse": {
        "properties": {
          "server_url": {
            "type": "string",
            "title": "Server Url",
            "description": "接続先の LiveKit の URL"
          },
          "participant_token": {
            "type": "string",
            "title": "Participant Token",
            "description": "LiveKit の参加用トークン"
          }
        },
        "type": "object",
        "required": [
          "server_url",
          "participant_token"
        ],
        "title": "LiveKitTokenResponse"
      },
      "PutUserRequest": {
        "properties": {
          "display_name": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Display Name",
            "description": "表示名"
          },
          "language": {
            "type": "string",
            "enum": [
              "es",
              "pt",
              "fr",
              "ja",
              "ru",
              "zh",
              "de",
              "ko",
              "hi",
              "id",
              "vi",
              "it",
              "en"
            ],
            "title": "Language"
          }
        },
        "type": "object",
        "required": [
          "display_name",
          "language"
        ],
        "title": "PutUserRequest"
      },
      "Room": {
        "properties": {
          "room_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Room Id",
            "description": "ルームの ID"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "description": "ルームの表示名"
          },
          "member_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Member Ids",
            "description": "メンバーの user_id(Cognito の sub)"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO 8601(UTC)"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At",
            "description": "ISO 8601(UTC)"
          }
        },
        "type": "object",
        "required": [
          "room_id",
          "name",
          "member_ids",
          "created_at",
          "updated_at"
        ],
        "title": "Room"
      },
      "RoomList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Room"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "RoomList"
      },
      "UpdateRoomRequest": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1,
                "description": "ルームの表示名"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "member_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "description": "メンバーの user_id(Cognito の sub)"
              },
              {
                "type": "null"
              }
            ],
            "title": "Member Ids"
          }
        },
        "type": "object",
        "title": "UpdateRoomRequest"
      },
      "User": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "Cognito の sub"
          },
          "display_name": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Display Name",
            "description": "表示名"
          },
          "language": {
            "type": "string",
            "enum": [
              "es",
              "pt",
              "fr",
              "ja",
              "ru",
              "zh",
              "de",
              "ko",
              "hi",
              "id",
              "vi",
              "it",
              "en"
            ],
            "title": "Language",
            "description": "話す言語。翻訳音声もこの言語で聞く"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO 8601(UTC)"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At",
            "description": "ISO 8601(UTC)"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "display_name",
          "language",
          "created_at",
          "updated_at"
        ],
        "title": "User"
      },
      "UserList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/User"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "UserList"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ResponseValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "ResponseValidationError"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
