{
  "openapi": "3.1.0",
  "info": {
    "title": "voice-intercom API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "死活監視",
        "operationId": "getHealth",
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/livekit/token": {
      "post": {
        "tags": [
          "livekit"
        ],
        "summary": "LiveKit の参加用トークンを発行する",
        "operationId": "createLiveKitToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LiveKitTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "401": {
            "description": "トークンがない、または不正",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveKitTokenResponse"
                }
              }
            }
          },
          "403": {
            "description": "このトークンでは使えない",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveKitTokenResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "LiveKitTokenRequest": {
        "properties": {
          "room_name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Room Name",
            "description": "入るルームの名前"
          }
        },
        "type": "object",
        "required": [
          "room_name"
        ],
        "title": "LiveKitTokenRequest"
      },
      "LiveKitTokenResponse": {
        "properties": {
          "server_url": {
            "type": "string",
            "title": "Server Url",
            "description": "接続先の LiveKit の URL"
          },
          "participant_token": {
            "type": "string",
            "title": "Participant Token",
            "description": "LiveKit の参加用トークン"
          }
        },
        "type": "object",
        "required": [
          "server_url",
          "participant_token"
        ],
        "title": "LiveKitTokenResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ResponseValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "ResponseValidationError"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
