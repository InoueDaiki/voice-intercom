{
  "name": "voice-intercom",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "runServices": ["workspace", "oidc"],
  "workspaceFolder": "/workspaces/voice-intercom",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/aws-cli:1": {}
  },
  "containerEnv": {
    "TZ": "Asia/Tokyo",
    // Claude Code の設定とログイン情報をまとめて名前付きボリュームに置き、作り直しても残す
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // pnpm のストアを名前付きボリュームに置く(指定しないとリポジトリの直下に .pnpm-store ができる)
    "pnpm_config_store_dir": "/home/vscode/.local/share/pnpm-store"
  },
  "remoteEnv": {
    // DooD でボリュームをマウントするときは、ホスト側のパスを使う
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },
  "postCreateCommand": ".devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-pyright.pyright",
        "bufbuild.vscode-buf",
        "hashicorp.terraform",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "hverlin.mise-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/voice-intercom/.venv/bin/python",
        // 型検査は CLI と同じ版の Pyright 拡張に任せ、Pylance は止める(診断が二重に出るため)
        "python.languageServer": "None"
      }
    }
  }
}
